// ===================================================
// HRMS Backend — Prisma Schema (Merged)
// Person 1 (Foundation): Odusanya Abayomi
// Person 3 (Leave, Notifications, Audit)
// Person 4 (Goals, Performance Reviews): Odusanya Abayomi
//
// Recruitment models (Job, Applicant, Interview — Person 2) are NOT yet
// merged here. Coordinate with Person 2 before they add theirs — same
// single-file rule applies.
// ===================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------
// ENUMS
// ---------------------------------------------------

enum RoleName {
  super_admin
  hr_admin
  manager
  employee
  applicant
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern
}

enum EmployeeStatus {
  active
  inactive
  exited
}

enum JobStatus {
  draft
  open
  on_hold
  closed
}

enum ApplicationStatus {
  new
  in_review
  shortlisted
  interviewed
  offered
  hired
  rejected
}

enum InterviewMode {
  onsite
  remote
  phone
}

enum InterviewStatus {
  scheduled
  completed
  cancelled
  rescheduled
enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled
  expired
}

enum GoalStatus {
  on_track
  at_risk
  completed
  overdue
}

enum ReviewStatus {
  in_progress
  completed
  upcoming
  archived
}

enum FeedbackStatus {
  draft
  submitted
}

enum PayslipStatus {
  generated
  paid
}

enum AttendanceStatus {
  present
  absent
  late
  weekly_off
  on_leave
}

// ---------------------------------------------------
// COMPANIES (multi-tenancy root)
// ---------------------------------------------------

model Company {
  id                  Int      @id @default(autoincrement())
  name                String
  registrationNumber  String?  @map("registration_number")
  industry            String?
  phoneNumber         String?  @map("phone_number")
  email               String?
  website             String?
  address             String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users        User[]
  departments  Department[]
  employees    Employee[]
  jobs         Job[]
  leaveTypes   LeaveType[]

  @@map("companies")
}

// ---------------------------------------------------
// ROLES (static reference table, seeded once)
// ---------------------------------------------------

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique

  users User[]

  @@map("roles")
}

// ---------------------------------------------------
// USERS (login/identity — separate from profile data)
// ---------------------------------------------------

model User {
  id                  Int       @id @default(autoincrement())
  companyId           Int?      @map("company_id")
  roleId              Int       @map("role_id")
  email               String    @unique
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  isVerified          Boolean   @default(false) @map("is_verified")
  resetToken          String?   @map("reset_token")
  resetTokenExpires   DateTime? @map("reset_token_expires")
  refreshToken        String?   @map("refresh_token")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  applicant      Applicant?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id])
  employee       Employee?
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([companyId])
  @@map("users")
}

// ---------------------------------------------------
// DEPARTMENTS
// ---------------------------------------------------

model Department {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  name       String
  headId     Int?     @map("head_id")
  createdAt  DateTime @default(now()) @map("created_at")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  head       Employee?  @relation("DepartmentHead", fields: [headId], references: [id])
  employees  Employee[] @relation("EmployeeDepartment")
  jobs       Job[]
  goals      Goal[]

  @@index([companyId])
  @@map("departments")
}

// ---------------------------------------------------
// EMPLOYEES (role-specific profile data, FK to User)
// ---------------------------------------------------

model Employee {
  id                      Int             @id @default(autoincrement())
  userId                  Int             @unique @map("user_id")
  companyId               Int             @map("company_id")
  departmentId            Int?            @map("department_id")
  employeeCode            String?         @map("employee_code")
  firstName               String          @map("first_name")
  lastName                String          @map("last_name")
  dateOfBirth             DateTime?       @map("date_of_birth")
  gender                  String?
  maritalStatus           String?         @map("marital_status")
  nationality             String?
  address                 String?
  phoneNumber             String?         @map("phone_number")
  position                String?
  employmentType          EmploymentType? @map("employment_type")
  dateOfJoining           DateTime?       @map("date_of_joining")
  reportsToId             Int?            @map("reports_to")
  status                  EmployeeStatus  @default(active)
  emergencyContactName    String?         @map("emergency_contact_name")
  emergencyContactPhone   String?         @map("emergency_contact_phone")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department          Department?        @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  reportsTo           Employee?          @relation("EmployeeManager", fields: [reportsToId], references: [id])
  directReports       Employee[]         @relation("EmployeeManager")
  headOfDepartments   Department[]       @relation("DepartmentHead")
  documents           EmployeeDocument[]
  jobsPosted          Job[]
  interviewsConducted Interview[]

  // --- Person 3: Leave ---
  leaveRequests        LeaveRequest[]         @relation("EmployeeLeaveRequests")
  leaveApprovalsGiven  LeaveRequest[]         @relation("LeaveApprover")
  leaveBalances        LeaveBalance[]
  leaveHistoryActions  LeaveApprovalHistory[] @relation("LeaveHistoryActor")

  // --- Person 4: Goals & Performance ---
  goals              Goal[]              @relation("EmployeeGoals")
  goalsOwned         Goal[]              @relation("GoalOwner")
  reviewsReceived    PerformanceReview[] @relation("EmployeeReviews")
  reviewsConducted   PerformanceReview[] @relation("ReviewerReviews")

  // --- Payroll & Attendance ---
  salaryStructures   SalaryStructure[]
  payslips           Payslip[]
  attendanceRecords  AttendanceRecord[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@index([reportsToId])
  @@map("employees")
}

// ---------------------------------------------------
// EMPLOYEE DOCUMENTS
// ---------------------------------------------------

model EmployeeDocument {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  documentType  String?  @map("document_type")
  fileUrl       String   @map("file_url")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

// ---------------------------------------------------
// JOBS
// ---------------------------------------------------

model Job {
  id             Int             @id @default(autoincrement())
  companyId      Int             @map("company_id")
  departmentId   Int?            @map("department_id")
  postedById     Int?            @map("posted_by")
  jobCode        String?         @map("job_code")
  title          String
  description    String?
  requirements   String?
  location       String?
  employmentType EmploymentType? @map("employment_type")
  status         JobStatus       @default(draft)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id])
  postedBy    Employee?   @relation(fields: [postedById], references: [id])
  applicants  Applicant[]

  @@unique([companyId, jobCode])
  @@index([companyId])
  @@index([departmentId])
  @@map("jobs")
}

// ---------------------------------------------------
// APPLICANTS
// ---------------------------------------------------

model Applicant {
  id           Int               @id @default(autoincrement())
  jobId        Int               @map("job_id")
  userId       Int?              @unique @map("user_id")
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  email        String
  phoneNumber  String?           @map("phone_number")
  resumeUrl    String?           @map("resume_url")
  coverLetter  String?           @map("cover_letter")
  status       ApplicationStatus @default(new)
  appliedAt    DateTime          @default(now()) @map("applied_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])
  interviews Interview[]

  @@index([jobId])
  @@map("applicants")
}

// ---------------------------------------------------
// INTERVIEWS
// ---------------------------------------------------

model Interview {
  id            Int             @id @default(autoincrement())
  applicantId   Int             @map("applicant_id")
  interviewerId Int?            @map("interviewer_id")
  scheduledAt   DateTime        @map("scheduled_at")
  mode          InterviewMode   @default(onsite)
  status        InterviewStatus @default(scheduled)
  feedback      String?
  rating        Int?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewer Employee? @relation(fields: [interviewerId], references: [id])

  @@index([applicantId])
  @@map("interviews")
}
// ===================================================
// PERSON 3 — LEAVE MANAGEMENT, NOTIFICATIONS, AUDIT
// ===================================================

model LeaveType {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  name        String                                   // Annual, Sick, Maternity, Study, Other
  defaultDays Decimal? @db.Decimal(5, 1) @map("default_days")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@index([companyId])
  @@map("leave_types")
}

model LeaveBalance {
  id          Int     @id @default(autoincrement())
  employeeId  Int     @map("employee_id")
  leaveTypeId Int     @map("leave_type_id")
  year        Int
  totalDays   Decimal @db.Decimal(5, 1) @map("total_days")
  usedDays    Decimal @default(0) @db.Decimal(5, 1) @map("used_days")
  pendingDays Decimal @default(0) @db.Decimal(5, 1) @map("pending_days")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id              Int                 @id @default(autoincrement())
  employeeId      Int                 @map("employee_id")
  leaveTypeId     Int                 @map("leave_type_id")
  startDate       DateTime            @map("start_date")
  endDate         DateTime            @map("end_date")
  totalDays       Decimal?            @db.Decimal(5, 1) @map("total_days")
  reason          String?
  attachmentUrl   String?             @map("attachment_url")
  status          LeaveRequestStatus  @default(pending)
  approverId      Int?                @map("approver_id")
  approvalComment String?             @map("approval_comment")
  submittedAt     DateTime            @default(now()) @map("submitted_at")
  decidedAt       DateTime?           @map("decided_at")

  employee        Employee               @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType              @relation(fields: [leaveTypeId], references: [id])
  approver         Employee?              @relation("LeaveApprover", fields: [approverId], references: [id])
  approvalHistory  LeaveApprovalHistory[]

  @@index([employeeId])
  @@map("leave_requests")
}

model LeaveApprovalHistory {
  id             Int      @id @default(autoincrement())
  leaveRequestId Int      @map("leave_request_id")
  actorId        Int?     @map("actor_id")
  action         String                                 // submitted, approved, rejected, cancelled
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  actor        Employee?    @relation("LeaveHistoryActor", fields: [actorId], references: [id])

  @@index([leaveRequestId])
  @@map("leave_approval_history")
}

model Notification {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  type              String?                              // leave_request, applicant, review_reminder, system
  title             String?
  message           String?
  isRead            Boolean  @default(false) @map("is_read")
  isImportant       Boolean  @default(false) @map("is_important")
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   Int?     @map("related_entity_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String?                                       // e.g. "created employee", "approved leave"
  module    String?
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

// ===================================================
// PERSON 4 — GOALS & PERFORMANCE REVIEWS
// ===================================================

model Goal {
  id            Int        @id @default(autoincrement())
  employeeId    Int        @map("employee_id")
  goalOwnerId   Int?       @map("goal_owner_id")
  departmentId  Int?       @map("department_id")
  title         String
  category      String?
  description   String?
  weight        Decimal?   @db.Decimal(5, 2)
  dueDate       DateTime?  @map("due_date")
  status        GoalStatus @default(on_track)
  progress      Decimal    @default(0) @db.Decimal(5, 2)
  year          Int
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  employee      Employee            @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)
  goalOwner     Employee?           @relation("GoalOwner", fields: [goalOwnerId], references: [id])
  department    Department?         @relation(fields: [departmentId], references: [id])
  reviewRatings ReviewGoalRating[]

  @@index([employeeId])
  @@index([year])
  @@map("goals")
}

model PerformanceReview {
  id                    Int            @id @default(autoincrement())
  employeeId            Int            @map("employee_id")
  reviewerId            Int            @map("reviewer_id")
  reviewType            String?        @map("review_type")
  reviewPeriodStart     DateTime?      @map("review_period_start")
  reviewPeriodEnd       DateTime?      @map("review_period_end")
  status                ReviewStatus   @default(in_progress)
  feedbackStatus        FeedbackStatus @default(draft) @map("feedback_status")
  overallRating         Decimal?       @db.Decimal(3, 1) @map("overall_rating")
  strengths             String?
  areasForImprovement   String?        @map("areas_for_improvement")
  additionalComments    String?        @map("additional_comments")
  submittedAt           DateTime?      @map("submitted_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  employee          Employee                 @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer          Employee                 @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  goalRatings       ReviewGoalRating[]
  competencyRatings ReviewCompetencyRating[]

  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_reviews")
}

model ReviewGoalRating {
  id             Int      @id @default(autoincrement())
  reviewId       Int      @map("review_id")
  goalId         Int      @map("goal_id")
  employeeRating Decimal? @db.Decimal(3, 1) @map("employee_rating")
  reviewerRating Decimal? @db.Decimal(3, 1) @map("reviewer_rating")
  score          Decimal? @db.Decimal(4, 2)

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  goal   Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([reviewId, goalId])
  @@index([reviewId])
  @@map("review_goal_ratings")
}

model ReviewCompetencyRating {
  id             Int      @id @default(autoincrement())
  reviewId       Int      @map("review_id")
  competencyName String   @map("competency_name")
  rating         Decimal? @db.Decimal(3, 1)

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_competency_ratings")
}

// ===================================================
// PAYROLL
// Simplified fixed-percentage tax/pension/NHF for MVP — not a real
// Nigerian tax engine. Documented assumption, not a bug.
// ===================================================

model SalaryStructure {
  id                 Int      @id @default(autoincrement())
  employeeId         Int      @map("employee_id")
  basicSalary        Decimal  @db.Decimal(12, 2) @map("basic_salary")
  housingAllowance   Decimal  @default(0) @db.Decimal(12, 2) @map("housing_allowance")
  transportAllowance Decimal  @default(0) @db.Decimal(12, 2) @map("transport_allowance")
  otherAllowance     Decimal  @default(0) @db.Decimal(12, 2) @map("other_allowance")
  pensionRate        Decimal  @default(8.0) @db.Decimal(5, 2) @map("pension_rate")
  taxRate            Decimal? @db.Decimal(5, 2) @map("tax_rate")
  nhfRate            Decimal  @default(2.5) @db.Decimal(5, 2) @map("nhf_rate")
  effectiveFrom      DateTime @map("effective_from")
  createdAt          DateTime @default(now()) @map("created_at")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([employeeId])
  @@map("salary_structures")
}

model Payslip {
  id                Int           @id @default(autoincrement())
  employeeId        Int           @map("employee_id")
  salaryStructureId Int?          @map("salary_structure_id")
  month             Int
  year              Int
  grossEarnings     Decimal?      @db.Decimal(12, 2) @map("gross_earnings")
  pensionDeduction  Decimal?      @db.Decimal(12, 2) @map("pension_deduction")
  taxDeduction      Decimal?      @db.Decimal(12, 2) @map("tax_deduction")
  nhfDeduction      Decimal?      @db.Decimal(12, 2) @map("nhf_deduction")
  otherDeductions   Decimal       @default(0) @db.Decimal(12, 2) @map("other_deductions")
  netSalary         Decimal?      @db.Decimal(12, 2) @map("net_salary")
  status            PayslipStatus @default(generated)
  paidOn            DateTime?     @map("paid_on")
  fileUrl           String?       @map("file_url")
  createdAt         DateTime      @default(now()) @map("created_at")

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  @@unique([employeeId, month, year])
  @@map("payslips")
}

// ===================================================
// ATTENDANCE
// ===================================================

model AttendanceRecord {
  id         Int              @id @default(autoincrement())
  employeeId Int              @map("employee_id")
  date       DateTime         @db.Date
  status     AttendanceStatus
  clockIn    DateTime?        @map("clock_in") @db.Time
  clockOut   DateTime?        @map("clock_out") @db.Time
  createdAt  DateTime         @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance_records")
}
